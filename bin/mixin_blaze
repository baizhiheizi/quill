#!/usr/bin/env ruby

require "rubygems"
require "bundler/setup"
require File.expand_path("../config/environment", __dir__)

# Mixin integration loop. Runs until the container is stopped and restarts
# itself if it exits unexpectedly.
#
# - Snapshots: the Safe snapshot poller, paced by MixinApi::Gate.
run_forever = lambda do |name, &block|
  Thread.new do
    loop do
      block.call
    rescue StandardError => e
      Rails.logger.error "#{name} exited unexpectedly: #{e.inspect}\n#{e.backtrace.join("\n")}"
      MixinApi::ErrorNotification.notify_unless_mixin_api(e, context: name) if Rails.env.production?
      sleep 10
    end
  end
end

thrs = []
thrs << run_forever.call("MixinNetworkSnapshot.poll") { MixinNetworkSnapshot.poll }

thrs.each(&:join)
