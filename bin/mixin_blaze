#!/usr/bin/env ruby

require "rubygems"
require "bundler/setup"
require File.expand_path("../config/environment", __dir__)

# Mixin integration loops. Each runs until the container is stopped and
# restarts itself if it exits unexpectedly.
#
# - Blaze: the gem's fiber-based reactor (Async) owns the WebSocket —
#   connect, keepalive, read, ack, reconnect with backoff. No EventMachine.
# - Snapshots: the Safe snapshot poller, paced by MixinApi::Gate.
run_forever = lambda do |name, &block|
  Thread.new do
    loop do
      block.call
    rescue StandardError => e
      Rails.logger.error "#{name} exited unexpectedly: #{e.inspect}\n#{e.backtrace.join("\n")}"
      MixinApi::ErrorNotification.notify_unless_mixin_api(e, context: name) if Rails.env.production?
      sleep 10
    end
  end
end

thrs = []
thrs << run_forever.call("MixinBot::Blaze::Reactor") { QuillBot.blaze_reactor.run } if Settings.blaze_enable
thrs << run_forever.call("MixinNetworkSnapshot.poll") { MixinNetworkSnapshot.poll }

thrs.each(&:join)
