<%= turbo_stream.append "#{dom_id current_user}_payments_list" do %>
  <%= render partial: "dashboard/payments/payment", collection: @payments, as: :payment %>
<% end %>

<%= turbo_stream.update "#{dom_id current_user}_payments_pagination" do %>
  <%= render_pagination @pagy, id: "#{dom_id current_user}_payments_pagination" %>
<% end %>
