<%= turbo_frame_tag "#{dom_id current_user}_subscribed_by_users" do %>
  <div data-controller="infinite-scroll">
    <% if @users.blank? %>
      <%= render_empty text: t('no_record') %>
    <% else %>
      <div id="<%= dom_id current_user %>_subscribed_by_list">
          <%= render partial: "dashboard/subscribe_by_users/user", collection: @users, as: :user %>
      </div>
      <div data-infinite-scroll-target='scrollArea'></div>
      <%= render_pagination @pagy, id: 'subscribed_by_users_pagination' %>
    <% end %>
  </div>
<% end %>
