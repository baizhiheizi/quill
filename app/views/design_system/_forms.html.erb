<%# specs/011-comprehensive-ui-refactor — design-system reference: forms. %>
<div class="ds-forms-grid grid grid-cols-1 gap-4 md:grid-cols-2">
  <div class="flex flex-col gap-2">
    <label class="text-sm font-medium" for="ds-input-title">Title</label>
    <input id="ds-input-title" type="text" placeholder="A great headline" class="input rounded-[10px] border border-base-300 bg-base-100 px-3 py-2 focus-ring" />
    <span class="text-xs text-base-content/60">Up to 120 characters.</span>
  </div>
  <div class="flex flex-col gap-2">
    <label class="text-sm font-medium" for="ds-input-bio">Biography</label>
    <textarea id="ds-input-bio" rows="3" placeholder="Tell us about your writing…" class="textarea rounded-[10px] border border-base-300 bg-base-100 px-3 py-2 focus-ring"></textarea>
  </div>
</div>