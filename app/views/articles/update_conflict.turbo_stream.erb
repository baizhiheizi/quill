<%= turbo_stream.replace "#{dom_id @article}_save_status" do %>
  <%= render "articles/save_status", article: @article, status: :conflict %>
<% end %>

<%= turbo_stream.update "article-form-meta" do %>
  <span data-article-form-lock-version-param="<%= @article.lock_version %>"></span>
  <%= hidden_field_tag "article[lock_version]", @article.lock_version %>
<% end %>

<%= turbo_stream.after "#{dom_id @article}_save_status" do %>
  <%= render "articles/conflict_resolution", article: @article %>
<% end %>
