<%# Load gtag after first paint. The previous head <script async src=gtag>
    still opened a connection during startup; when googletagmanager.com is
    unreachable that hung for 10s+ and competed with CSS/JS. %>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-TNT4ZMVDL4');

  function loadGtag() {
    var s = document.createElement('script');
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TNT4ZMVDL4';
    s.async = true;
    document.head.appendChild(s);
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadGtag, { timeout: 4000 });
  } else {
    window.addEventListener('load', function () { setTimeout(loadGtag, 1); });
  }
</script>
