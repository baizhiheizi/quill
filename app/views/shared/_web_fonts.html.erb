<%# Self-hosted Inter + Newsreader (latin). CJK falls through to system
    faces in --font-sans / --font-serif so we never block first paint on
    fonts.googleapis.com. font-display:swap keeps text visible immediately. %>
<% latin_range = "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" %>
<style>
  @font-face {
    font-family: "Inter";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("<%= asset_path("inter-latin-400-normal.woff2") %>") format("woff2");
    unicode-range: <%= latin_range %>;
  }
  @font-face {
    font-family: "Inter";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("<%= asset_path("inter-latin-500-normal.woff2") %>") format("woff2");
    unicode-range: <%= latin_range %>;
  }
  @font-face {
    font-family: "Inter";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("<%= asset_path("inter-latin-600-normal.woff2") %>") format("woff2");
    unicode-range: <%= latin_range %>;
  }
  @font-face {
    font-family: "Newsreader";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("<%= asset_path("newsreader-latin-500-normal.woff2") %>") format("woff2");
    unicode-range: <%= latin_range %>;
  }
  @font-face {
    font-family: "Newsreader";
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url("<%= asset_path("newsreader-latin-500-italic.woff2") %>") format("woff2");
    unicode-range: <%= latin_range %>;
  }
  @font-face {
    font-family: "Newsreader";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("<%= asset_path("newsreader-latin-600-normal.woff2") %>") format("woff2");
    unicode-range: <%= latin_range %>;
  }
</style>
