{
  "name": "quill",
  "private": true,
  "scripts": {
    "lint": "prettier --write --no-error-on-unmatched-pattern app/javascript/**/*.{tsx,ts,js,gql}",
    "lint-check": "prettier --check --no-error-on-unmatched-pattern app/javascript/**/*.{tsx,ts,js,gql}",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css",
    "build": "node esbuild.config.js",
    "build:css:watch": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --watch",
    "build:watch": "node esbuild.config.js --watch",
    "test": "bun test",
    "test:js": "bun test test/javascript/"
  },
  "version": "0.1.0",
  "dependencies": {
    "@37signals/lexxy": "^0.9.33",
    "@hotwired/stimulus": "^3.2.2",
