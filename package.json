    "@rails/activestorage": "^8.1.400",
    "@rails/request.js": "^0.0.13",
    "@tailwindcss/typography": "^0.5.20",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "flyonui": "^2.4.1",
    "highlight.js": "^11.12.0",
    "mixin-messenger-utils": "^0.1.5",
    "photoswipe": "^5.4.4",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "stimulus-use": "^0.53.1",
    "tailwindcss": "^4.3.3",
    "tom-select": "^2.6.2"
